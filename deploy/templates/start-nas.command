#!/bin/bash
cd "$(dirname "$0")"

echo "=================================================="
echo "🚀 MiniNAS를 시작합니다..."
echo "=================================================="

# install.sh 실행하여 백그라운드 서비스로 바로 등록 및 가동
./install.sh

echo "=================================================="
echo "🎉 MiniNAS가 성공적으로 켜졌습니다!"
echo "창을 닫으셔도 백그라운드에서 24시간 계속 동작합니다."
echo "=================================================="
sleep 2
