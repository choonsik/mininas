#!/bin/bash
cd "$(dirname "$0")"

echo "=================================================="
echo "🛑 MiniNAS를 종료합니다..."
echo "=================================================="

# uninstall.sh 실행하여 백그라운드 서비스 및 프로세스 중지
./uninstall.sh

echo "=================================================="
echo "✅ MiniNAS가 안전하게 꺼졌습니다."
echo "※ 저장소의 파일(사진, 동영상 등)은 안전하게 보존됩니다."
echo "=================================================="
sleep 2
